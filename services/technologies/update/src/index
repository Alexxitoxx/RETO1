const express = require("express");
const { Pool } = require("pg");
require("dotenv").config();

// Crea la instancia de la aplicación Express.
const app = express();

// Permite interpretar los cuerpos de las solicitudes como JSON.
app.use(express.json());

// Configura el grupo de conexiones usando las variables de entorno.
const pool = new Pool({
    host: process.env.DB_HOST,
    port: process.env.DB_PORT,
    database: process.env.DB_NAME,
    user: process.env.DB_USER,
    password: process.env.DB_PASSWORD
});

// Endpoint de salud para verificar que el servicio está activo.
app.get("/health", (req, res) => {
    res.json({
        status: "ok"
    });
});

// PUT - Actualizar tecnología
app.put("/v1/api/technologies/update/:id", async (req, res) => {
    const { id } = req.params;

    const {
        name,
        sector,
        description,
        adoptionLevel
    } = req.body;

    if (!name || !sector || !description || !adoptionLevel) {
        return res.status(400).json({
            message: "All fields are required"
        });
    }

    try {
        const existing = await pool.query(
            "SELECT * FROM technologies WHERE id = $1",
            [id]
        );

        if (existing.rows.length === 0) {
            return res.status(404).json({
                message: "Technology not found"
            });
        }

        const result = await pool.query(
            `
            UPDATE technologies
            SET
                name = $1,
                sector = $2,
                description = $3,
                adoption_level = $4,
                updated_at = CURRENT_TIMESTAMP
            WHERE id = $5
            RETURNING *
            `,
            [
                name,
                sector,
                description,
                adoptionLevel,
                id
            ]
        );

        res.status(200).json(result.rows[0]);

    } catch (error) {
        console.error("Error updating technology:", error);

        res.status(500).json({
            message: "Internal server error"
        });
    }
});


const technologyFields = ["name", "sector", "description", "adoptionLevel"];
const adoptionLevels = ["Bajo", "Medio", "Alto", "low", "medium", "high"];

// Reutiliza las reglas del alta para garantizar actualizaciones completas y válidas.
function validateTechnology(body) {
    const details = [];
    const unknown = Object.keys(body || {}).filter((key) => !technologyFields.includes(key));
    if (unknown.length) details.push(`Unknown fields: ${unknown.join(", ")}`);
    for (const field of ["name", "sector", "description"]) if (!body || typeof body[field] !== "string" || !body[field].trim()) details.push(`${field} is required`);
    if (!body || !adoptionLevels.includes(body.adoptionLevel)) details.push("adoptionLevel must be low, medium, high, Bajo, Medio or Alto");
    return details;
}

function technologyView(row) {
    // Normaliza la salida SQL al contrato público de la API.
    return { id: row.id, name: row.name, sector: row.sector, description: row.description, adoptionLevel: row.adoption_level, createdAt: row.created_at, updatedAt: row.updated_at };
}

// Actualiza una tecnología existente mediante una consulta parametrizada.
app.put("/v2/api/technologies/update/:id", async (req, res) => {
    if (!/^\d+$/.test(req.params.id)) return res.status(400).json({ message: "Validation error", details: ["id must be a positive integer"] });
    const details = validateTechnology(req.body);
    if (details.length) return res.status(400).json({ message: "Validation error", details });
    try {
        const result = await pool.query("UPDATE technologies SET name = $1, sector = $2, description = $3, adoption_level = $4, updated_at = CURRENT_TIMESTAMP WHERE id = $5 RETURNING *", [req.body.name.trim(), req.body.sector.trim(), req.body.description.trim(), req.body.adoptionLevel, req.params.id]);
        if (!result.rows.length) return res.status(404).json({ message: "Technology not found", details: [] });
        res.status(200).json(technologyView(result.rows[0]));
    } catch (error) {
        console.error("Error updating technology v2:", error);
        res.status(500).json({ message: "Internal server error", details: [] });
    }
});

// Convierte errores de JSON inválido en una respuesta JSON consistente.
app.use((error, req, res, next) => {
    if (error instanceof SyntaxError && error.status === 400 && error.body !== undefined) {
        return res.status(400).json({ message: "Validation error", details: ["Request body must be valid JSON"] });
    }
    next(error);
});

const PORT = 8008;

app.listen(PORT, () => {
    console.log(`UpdateTechnologyService running on port ${PORT}`);
});